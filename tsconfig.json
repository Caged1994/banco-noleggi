{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": false,
    "noImplicitAny": false,
    "rootDir": "src",
    "outDir": "build/js",
    "skipLibCheck": true,
    "removeComments": false
  },
  "include": ["src"]
}
